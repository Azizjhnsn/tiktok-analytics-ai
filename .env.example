# Copy to .env.local (git-ignored), fill in, then run `npm run build`.
# Folder suggested and copied by "Copy path" on the dashboard export, e.g. C:\Users\you\TikTokExports
WXT_EXPORT_DIR=
# Your OpenAI API key (sk-...). A key entered on the dashboard overrides this.
WXT_OPENAI_API_KEY=
# Model for the diagnosis (defaults to gpt-5-mini when empty).
WXT_OPENAI_MODEL=gpt-5-mini
